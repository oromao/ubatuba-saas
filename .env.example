# =============================================================================
# FlyDea SaaS — Environment Variables Reference
# Copy this file to .env and fill in the values for your environment
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
LOG_HTTP_ALL=false

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=rootpass
MONGO_URL=mongodb://root:rootpass@localhost:27017/flydea?authSource=admin

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
# IMPORTANT: change JWT_SECRET to a strong random value (≥64 chars) in production
JWT_SECRET=super-secret-change-me-to-something-random-and-long
CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000

# ─── Tenant ──────────────────────────────────────────────────────────────────
TENANT_SLUG=ubatuba
ADMIN_EMAIL=admin@flydea.dev

# ─── GeoServer ───────────────────────────────────────────────────────────────
GEOSERVER_URL=http://geoserver:8080/geoserver
GEOSERVER_PUBLIC_URL=http://localhost:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver

# ─── MinIO (GeoTIFF / File Storage) ──────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=flydea-geotiffs
MINIO_REGION=us-east-1
MOCK_GEOTIFF_PATH=/infra/assets/mock-geotiff.tif

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Email / SMTP ────────────────────────────────────────────────────────────
SMTP_URL=smtp://user:pass@smtp.example.com:587
SMTP_FROM=noreply@flydea.dev

# ─── OSM Import ──────────────────────────────────────────────────────────────
OSM_BBOX=-45.110,-23.474,-45.040,-23.428
OSM_BBOX_ORDER=lonlat
OSM_INPUT_PATH=/data/osm-import
OSM_OUTPUT_PATH=/data/osm-export
OSM_OVERPASS_URLS=["https://overpass-api.de/api/interpreter"]
OSM_PROJECT_SLUG=ubatuba-ctm
OSM_TENANT_SLUG=ubatuba

# ─── REURB Config ────────────────────────────────────────────────────────────
REURB_PROJECT_NAME=REURB Ubatuba 2025
REURB_PROJECT_STATUS=ATIVO
REURB_FAMILY_COUNT=500
REURB_UNIT_COUNT=1200
REURB_ADERENCIA_PDF_PATH=/infra/assets/reurb-aderencia-template.pdf

# ─── POC (Proof of Concept Scoring) ──────────────────────────────────────────
POC_REPO_ROOT=/workspace

# ─── Integration Hub ─────────────────────────────────────────────────────────
INTEGRATION_HTTP_URL=http://localhost:4000/health
INTEGRATION_HTTP_METHOD=GET

# ─── Web (Next.js) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_LOG_LEVEL=warn
NEXT_PUBLIC_DEV_LOGS=false

# ─── Mongo Express (dev only) ─────────────────────────────────────────────────
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin
